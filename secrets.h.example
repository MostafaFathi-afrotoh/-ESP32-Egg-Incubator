#pragma once
// ============================================================
// secrets.h.example
// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored — do NOT commit real credentials.
// ============================================================

// WiFi
#define SECRET_WIFI_SSID       "YOUR_SSID"
#define SECRET_WIFI_PASS       "YOUR_PASSWORD"

// Adafruit IO (optional — leave as-is if unused)
#define SECRET_AIO_USER        "YOUR_AIO_USER"
#define SECRET_AIO_KEY         "YOUR_AIO_KEY"

// Telegram Bot (optional)
#define SECRET_TG_BOT_TOKEN    "YOUR_BOT_TOKEN"
#define SECRET_TG_CHAT_ID      "YOUR_CHAT_ID"

// Email crash reports (optional — email_reporter is disabled by default)
#define SECRET_EMAIL_FROM      "YOUR_EMAIL@gmail.com"
#define SECRET_EMAIL_PASSWORD  "YOUR_APP_PASSWORD"
#define SECRET_EMAIL_TO        "destination@example.com"
